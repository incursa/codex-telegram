<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Incursa.Codex.Telegram</AssemblyName>
    <RootNamespace>Incursa.Codex.Telegram</RootNamespace>
    <Version>1.0.39</Version>
    <AssemblyVersion>1.0.39.0</AssemblyVersion>
    <FileVersion>1.0.39.0</FileVersion>
    <UserSecretsId>incursa-codex-telegram</UserSecretsId>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\\..\\..\\codex-dotnet\\src\\Incursa.OpenAI.Codex\\Incursa.OpenAI.Codex.csproj')">
    <ProjectReference Include="..\\..\\..\\codex-dotnet\\src\\Incursa.OpenAI.Codex\\Incursa.OpenAI.Codex.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\\..\\..\\codex-dotnet\\src\\Incursa.OpenAI.Codex\\Incursa.OpenAI.Codex.csproj')">
    <PackageReference Include="Incursa.OpenAI.Codex" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\..\docs\assets\codex-telegram-logo.png"
          Link="Assets\codex-telegram-logo.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <PackageReference Include="Telegram.Bot" Version="22.10.0.1" />
  </ItemGroup>

</Project>
